# Lokal kopieren nach .env und anpassen. Auf Railway setzt du diese Werte als Service-Variablen.

# Railway Postgres: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nova

# Railway Bucket (Variable References auf den Bucket-Service)
BUCKET=
ENDPOINT=
REGION=auto
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
# Nur für ältere Buckets, wenn der Credentials-Tab «path-style» verlangt:
# S3_FORCE_PATH_STYLE=true

# Öffentliche Adresse. Auf Railway automatisch über RAILWAY_PUBLIC_DOMAIN.
# PUBLIC_URL=https://www.meine-domain.ch

# Optional: fester Einrichtungscode statt eines zufälligen aus den Logs
# NOVA_SETUP_CODE=123-456

# E-Mail. Railway blockiert SMTP auf Hobby-Plänen – Resend (HTTP) funktioniert überall.
# RESEND_API_KEY=
# MAIL_FROM=Gasthaus Linde <hallo@meine-domain.ch>
# SMTP_URL=smtps://user:pass@smtp.example.ch:465

# Online-Zahlung (TWINT, Karte, Apple/Google Pay)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optionaler unsichtbarer Spamschutz für Formulare
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
