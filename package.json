{
  "name": "nova-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Nova – ein CMS, zwei Modi. Studio für Laien, Werkbank für Profis.",
  "type": "module",
  "bin": {
    "nova": "dist/public/nova.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "migrate": "node dist/server.js --migrate-only",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
